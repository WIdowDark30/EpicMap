# Keep every file byte-for-byte as committed. The package mixes LF and CRLF
# files (for example "Epic Map.url", UPDATE.txt and some tests), and the release
# ZIP must match the repository exactly.
* -text

# Repository-only files. `git archive`, which builds the release ZIP, skips these.
/.github                  export-ignore
/.gitattributes           export-ignore
/.gitignore               export-ignore
/CHANGELOG.md             export-ignore
/tools                    export-ignore
/package-lock.json        export-ignore
/screenshots/*.jpg        export-ignore
/tests/launcher_test.rb   export-ignore
/tests/installer_test.ps1 export-ignore
